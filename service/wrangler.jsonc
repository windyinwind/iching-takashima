{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iching-takashima",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    // Route rather than a custom domain: the zone still carries apex records
    // imported from Onamae, and a Workers custom domain refuses to attach
    // while any record exists for the hostname (error 100117).
    { "pattern": "takashima-iching.com/*", "zone_name": "takashima-iching.com" }
  ],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/en", "/en/*", "/zh", "/zh/*", "/ja", "/ja/*", "/api/*", "/mcp", "/sitemap.xml", "/robots.txt"] },
  "observability": { "enabled": true }
}
